# Database (local)
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5433/assistant

# JWT
JWT_SECRET=change-me-to-a-random-32-byte-string

# LLM
LLM_PROVIDER=groq
LLM_MODEL=
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_REQUESTS_PER_TURN=6

# App
CORS_ORIGINS=http://localhost:4200
ADMIN_TOKEN=change-me
DEMO_MODE=true
